schema incident {
    document incident {
        field ticket_id type string {
            indexing: summary | attribute
            attribute: fast-search
        }
        field text type string {
            indexing: index | summary
            index: enable-bm25
        }
        field status type string {
            indexing: summary | attribute
            attribute: fast-search
        }
        field content_hash type string { indexing: summary }
        field updated_at_jira type string { indexing: summary }
        field updated_at_db type string { indexing: summary }
        field embedding_model_version type string { indexing: summary }
        field embedding type tensor<float>(x[2048]) {
            indexing: attribute | index | summary
            attribute { distance-metric: angular }
            index {
                hnsw {
                    max-links-per-node: 16
                    neighbors-to-explore-at-insert: 200
                }
            }
        }
    }
    fieldset default { fields: text }
    rank-profile bm25 {
        first-phase { expression: bm25(text) }
    }
    rank-profile semantic {
        inputs { query(q_embedding) tensor<float>(x[2048]) }
        first-phase { expression: closeness(field, embedding) }
    }
}
