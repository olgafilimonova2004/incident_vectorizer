JIRA_INDEXER_JIRA_URL=https://jira.example.org
JIRA_INDEXER_JIRA_TOKEN=replace-me
JIRA_INDEXER_JQL=project = PROJ ORDER BY updated ASC
JIRA_INDEXER_OVERLAP_SECONDS=300
JIRA_INDEXER_PAGE_SIZE=100

# For local CLI use http://localhost:8080 with the dev Compose override.
INCIDENT_VESPA_URL=http://vespa:8080
INCIDENT_VESPA_TIMEOUT=30
INCIDENT_EMBEDDER_BASE_URL=http://host.docker.internal:8000/v1
INCIDENT_EMBEDDER_API_KEY=
INCIDENT_EMBEDDER_MODEL=drawais/Qwen3-Embedding-4B-AWQ-INT4
INCIDENT_EMBEDDER_DIMENSIONS=2048
INCIDENT_EMBEDDER_PREFIX="passage: "
INCIDENT_EMBEDDER_BATCH_SIZE=32
INCIDENT_EMBEDDER_TIMEOUT=120
INCIDENT_LOCK_FILE=/tmp/incident-vectorizer/index.lock
